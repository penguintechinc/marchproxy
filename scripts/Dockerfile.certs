FROM debian:12-slim@sha256:66f47f9e94302e1e1ab2baf19c9a0107b75e4afb915b12a757575e33ce18cfb3

# Install OpenSSL for certificate generation
RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl \
    bash \
    && rm -rf /var/lib/apt/lists/*

# Create working directory and non-root user
RUN mkdir -p /certs && \
    useradd -m -u 1000 appuser && \
    chown -R appuser:appuser /certs

# Copy certificate generation script
COPY generate-certs.sh /generate-certs.sh
RUN chmod +x /generate-certs.sh && \
    chown appuser:appuser /generate-certs.sh

# Set working directory
WORKDIR /certs

# Run as non-root user
USER appuser

# Set default command
CMD ["/generate-certs.sh"]