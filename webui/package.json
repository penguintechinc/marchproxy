{
  "name": "marchproxy-webui",
  "version": "1.0.0",
  "description": "MarchProxy Web UI - React + TypeScript + Vite",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 100",
    "preview": "vite preview",
    "serve": "node server.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@emotion/react": "11.11.3",
    "@emotion/styled": "11.11.0",
    "@monaco-editor/react": "4.6.0",
    "@mui/icons-material": "5.15.10",
    "@mui/material": "5.15.10",
    "@mui/x-data-grid": "8.22.0",
    "@mui/x-date-pickers": "6.19.5",
    "@penguintechinc/react-aaa": "0.1.0",
    "@penguintechinc/react-libs": "1.3.0",
    "axios": "1.6.7",
    "d3-geo": "3.1.1",
    "date-fns": "3.3.1",
    "esbuild": "0.27.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "7.68.0",
    "react-query": "3.39.3",
    "react-router-dom": "6.22.0",
    "react-simple-maps": "1.0.0",
    "reactflow": "11.11.4",
    "recharts": "3.5.1",
    "zustand": "4.5.0"
  },
  "devDependencies": {
    "@penguintechinc/react-testutils": "0.1.0",
    "@playwright/test": "1.40.1",
    "@testing-library/jest-dom": "6.4.2",
    "@testing-library/react": "14.2.1",
    "@testing-library/user-event": "14.5.2",
    "@types/d3-geo": "3.1.0",
    "@types/node": "20.11.17",
    "@types/react": "18.2.55",
    "@types/react-dom": "18.2.19",
    "@types/react-simple-maps": "3.0.6",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "@vitejs/plugin-react": "4.2.1",
    "@vitest/coverage-v8": "1.4.0",
    "eslint": "8.56.0",
    "eslint-plugin-react-hooks": "4.6.0",
    "eslint-plugin-react-refresh": "0.4.5",
    "express": "4.18.2",
    "jsdom": "24.0.0",
    "terser": "5.44.1",
    "typescript": "5.3.3",
    "vite": "7.3.1",
    "vitest": "1.4.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}
